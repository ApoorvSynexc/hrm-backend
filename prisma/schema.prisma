// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  MISSING_CHECKIN
  MISSING_CHECKOUT
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HolidayType {
  PUBLIC
  FESTIVAL
  OPTIONAL
}

enum Status {
  ACTIVE
  INACTIVE
  DELETED
}

enum PermissionAction {
  manage
  create
  read
  update
  delete
  approve
}

enum PermissionSubject {
  all
  tenant
  user
  role
  permission
  employee
  department
  designation
  leave
  payroll
  attendance
  attendance_regularization
}

model Tenant {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String?                    @unique
  logo                      String?                    // URL to logo image
  status                    Status                     @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  refreshTokens             RefreshToken[]
  roles                     Role[]
  departments               Department[]
  leaves                    Leave[]
  payrolls                  Payroll[]
  rolePermissions           RolePermission[]
  attendances               Attendance[]
  attendanceRegularizations AttendanceRegularization[]
  domains                   TenantDomain[]
  workingSchedules          WorkingSchedule[]
  holidays                  Holiday[]
  leaveBalances             LeaveBalance[]
  counters                  Counter[]
}

model WorkingSchedule {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String   // e.g., "Standard", "Summer Schedule"
  day                   String   // "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"
  isWorking             Boolean  @default(true)  // true = working day, false = off (holiday, weekend)
  workingHoursPerDay    Int      @default(480)  // minutes: 480 = 8 hours, 420 = 7 hours, etc (only applies when isWorking=true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, day])
  @@index([tenantId])
  @@index([tenantId, name])
}

model TenantDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

model User {
  id                                String               @id @default(cuid())
  tenantId                          String?
  email                             String
  passwordHash                      String
  firstName                         String
  lastName                          String
  phone                             String?
  status                            Status               @default(ACTIVE)
  roleId                            String?

  // Employee-specific fields (optional - only for actual employees)
  employeeCode                      String?              // Only for actual employees
  departmentId                      String?
  designationId                     String?
  hireDate                          DateTime?            // Only for actual employees
  employmentStatus                  EmploymentStatus     @default(ACTIVE)
  salary                            Decimal?             @db.Decimal(12, 2)

  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt

  tenant                            Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                              Role?                @relation(fields: [roleId], references: [id], onDelete: NoAction)
  department                        Department?          @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: NoAction)
  designation                       Designation?         @relation(fields: [designationId], references: [id], onDelete: NoAction)
  refreshTokens                     RefreshToken[]
  leaves                            Leave[]
  payrolls                          Payroll[]
  attendances                       Attendance[]
  attendanceRegularizations         AttendanceRegularization[]
  reviewedAttendanceRegularizations AttendanceRegularization[] @relation("ReviewedBy")
  leaveBalances                     LeaveBalance[]

  @@unique([tenantId, email])
  @@unique([tenantId, employeeCode]) // Only enforced when employeeCode is set
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([roleId])
  @@index([departmentId, tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String?
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  status          Status           @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Permission {
  id              String                 @id @default(cuid())
  action          PermissionAction
  subject         PermissionSubject
  description     String?
  status          Status                 @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  rolePermissions RolePermission[]

  @@unique([action, subject])
}

model RolePermission {
  id           String     @id @default(cuid())
  tenantId     String?
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
}

model Department {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Designation {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
}

model Leave {
  id          String      @id @default(cuid())
  tenantId    String
  userId      String
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  recordStatus Status      @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  reason      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
}

model Payroll {
  id         String        @id @default(cuid())
  tenantId   String
  userId     String
  periodStart DateTime
  periodEnd  DateTime
  basicSalary Decimal      @db.Decimal(12, 2)
  allowances Decimal       @default(0) @db.Decimal(12, 2)
  deductions Decimal       @default(0) @db.Decimal(12, 2)
  netPay     Decimal       @db.Decimal(12, 2)
  status     PayrollStatus @default(DRAFT)
  recordStatus Status       @default(ACTIVE)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
}

model Attendance {
  id              String                     @id @default(cuid())
  tenantId        String
  userId          String
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  totalMinutes    Int?
  status          AttendanceStatus
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  regularizations AttendanceRegularization[]

  @@unique([tenantId, userId, date])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

model AttendanceRegularization {
  id                String               @id @default(cuid())
  tenantId          String
  userId            String
  attendanceId      String?
  date              DateTime
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            RegularizationStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance        Attendance?          @relation(fields: [attendanceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reviewedBy        User?                @relation("ReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([userId])
  @@index([attendanceId, tenantId])
  @@index([reviewedByUserId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

model Holiday {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  date      DateTime
  type      HolidayType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, date])
}

model LeaveBalance {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  year         Int
  leaveType    LeaveType
  totalDays    Int
  usedDays     Int      @default(0)
  remainingDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, year, leaveType])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, year])
}

model Counter {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   // e.g., "employee", "department", etc.
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name], name: "uk_counter_tenant_name")
  @@index([tenantId])
}
