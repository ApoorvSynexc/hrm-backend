// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  MISSING_CHECKIN
  MISSING_CHECKOUT
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendancePolicyType {
  STRICT
  FLEXIBLE
}

enum HolidayType {
  PUBLIC
  FESTIVAL
  OPTIONAL
}

enum Status {
  ACTIVE
  INACTIVE
  DELETED
}

enum PermissionAction {
  manage
  create
  read
  update
  delete
  approve
}

enum PermissionSubject {
  all
  tenant
  user
  role
  permission
  employee
  department
  designation
  leave
  payroll
  attendance
  attendance_regularization
  working_schedule
}

model Tenant {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String?                    @unique
  logo                      String? // URL to logo image
  timezone                  String                     @default("UTC") // e.g., "Asia/Kolkata", "America/New_York"

  // Office Location
  officeLatitude            Decimal?                   @db.Decimal(10, 8)
  officeLogitude            Decimal?                   @db.Decimal(11, 8)
  officeAddress             String?

  status                    Status                     @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  refreshTokens             RefreshToken[]
  roles                     Role[]
  departments               Department[]
  designations              Designation[]
  leaves                    Leave[]
  payrolls                  Payroll[]
  rolePermissions           RolePermission[]
  attendances               Attendance[]
  attendanceLogs            AttendanceLog[]
  attendanceRegularizations AttendanceRegularization[]
  domains                   TenantDomain[]
  workingSchedules          WorkingSchedule[]
  holidays                  Holiday[]
  leaveBalances             LeaveBalance[]
  counters                  Counter[]
  attendancePolicies        AttendancePolicy[]
}

model WorkingSchedule {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String // e.g., "Standard", "Summer Schedule"
  workingDays           String[] // e.g., ["MON", "TUE", "WED", "THU", "FRI"]
  startTime             String   // e.g., "09:00" (HH:mm format)
  endTime               String   // e.g., "17:00" (HH:mm format)
  breakDuration         Int      @default(0) // hours
  workingHoursPerDay    Int      @default(480) // minutes: 480 = 8 hours, 420 = 7 hours, etc
  fullDayMinimumMinutes Int      @default(480) // minutes needed to be marked PRESENT
  halfDayMinimumMinutes Int      @default(240) // minutes needed to be marked HALF_DAY
  lateMarkAfter         String?  // "HH:mm" — null means no late tracking
  graceTimeInMinutes    Int      @default(0) // grace period added to lateMarkAfter
  timezone              String   @default("UTC") // IANA timezone, e.g. "Asia/Kolkata"
  status                Status   @default(ACTIVE)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                 User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TenantDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

model User {
  id           String  @id @default(cuid())
  tenantId     String?

  // Auth
  email           String
  passwordHash    String
  lastLoginAt     DateTime?
  loginAttempts   Int      @default(0)
  lockedUntil     DateTime?

  // Basic Info
  firstName       String
  lastName        String
  avatarUrl       String?

  // HR Extensions
  dateOfBirth     DateTime?
  gender          String?
  maritalStatus   String?

  // Status
  status          Status   @default(ACTIVE)
  roleId          String?

  // Employee-specific fields (optional - only for actual employees)
  employeeCode      String?       // Only for actual employees
  departmentId      String?
  designationId     String?
  workingScheduleId String?
  joiningDate       DateTime?     // Employment start date
  confirmationDate  DateTime?     // Probation confirmation
  hireDate          DateTime?     // Deprecated - use joiningDate
  exitDate          DateTime?     // Employment end date
  employmentStatus  EmploymentStatus @default(ACTIVE)
  salary            Decimal?      @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                            Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                              Role?                      @relation(fields: [roleId], references: [id], onDelete: NoAction)
  department                        Department?                @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: NoAction)
  designation                       Designation?               @relation(fields: [designationId], references: [id], onDelete: NoAction)
  workingSchedule                   WorkingSchedule?           @relation(fields: [workingScheduleId], references: [id], onDelete: NoAction)
  refreshTokens                     RefreshToken[]
  leaves                            Leave[]
  payrolls                          Payroll[]
  attendances                       Attendance[]
  attendanceLogs                    AttendanceLog[]
  attendanceRegularizations         AttendanceRegularization[]
  reviewedAttendanceRegularizations AttendanceRegularization[] @relation("ReviewedBy")
  leaveBalances                     LeaveBalance[]
  contact                           Contact?
  address                           Address?

  @@unique([tenantId, email], where: { status: { not: "DELETED" } })
  @@unique([tenantId, employeeCode], where: { status: { not: "DELETED" } }) // Only enforced when employeeCode is set
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([roleId])
  @@index([departmentId, tenantId])
  @@index([workingScheduleId])
}

model Contact {
  id              String        @id @default(cuid())
  userId          String        @unique
  email           String
  isEmailVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileNumber    MobileNumber?

  @@index([userId])
}

model MobileNumber {
  id          String   @id @default(cuid())
  contactId   String   @unique
  dialCode    String
  iso2        String
  country     String
  number      String
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String   @unique
  street    String?
  city      String?
  state     String?
  stateIso2 String?
  country   String?
  iso2      String?
  zipCode   String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  geo       Json? // GeoJSON: { type: 'Point', coordinates: [longitude, latitude] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String?
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  status          Status           @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Permission {
  id              String            @id @default(cuid())
  action          PermissionAction
  subject         PermissionSubject
  description     String?
  status          Status            @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermission[]

  @@unique([action, subject], name: "uk_action_subject")
}

model RolePermission {
  id           String     @id @default(cuid())
  tenantId     String?
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
}

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Designation {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Leave {
  id           String      @id @default(cuid())
  tenantId     String
  userId       String
  type         LeaveType
  status       LeaveStatus @default(PENDING)
  recordStatus Status      @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
}

model Payroll {
  id           String        @id @default(cuid())
  tenantId     String
  userId       String
  periodStart  DateTime
  periodEnd    DateTime
  basicSalary  Decimal       @db.Decimal(12, 2)
  allowances   Decimal       @default(0) @db.Decimal(12, 2)
  deductions   Decimal       @default(0) @db.Decimal(12, 2)
  netPay       Decimal       @db.Decimal(12, 2)
  status       PayrollStatus @default(DRAFT)
  recordStatus Status        @default(ACTIVE)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
}

model Attendance {
  id             String                     @id @default(cuid())
  tenantId       String
  userId         String
  date           DateTime
  firstCheckIn   DateTime? // first check-in of the day (for quick access + late calc)
  lastCheckOut   DateTime? // last check-out of the day
  totalMinutes   Int?      // sum of all closed session durations
  status         AttendanceStatus
  isFinalStatus  Boolean                    @default(false) // true after cron or instant finalization
  isLate         Boolean                    @default(false) // true if firstCheckIn > lateMarkAfter + grace
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  regularizations AttendanceRegularization[]
  logs           AttendanceLog[]

  @@unique([tenantId, userId, date])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, isFinalStatus])
}

model AttendanceLog {
  id                String     @id @default(cuid())
  tenantId          String
  attendanceId      String
  userId            String
  checkIn           DateTime
  checkOut          DateTime?
  durationMinutes   Int?
  checkInIp         String?
  checkOutIp        String?
  checkInLatitude   Decimal?   @db.Decimal(10, 8)
  checkInLongitude  Decimal?   @db.Decimal(11, 8)
  checkOutLatitude  Decimal?   @db.Decimal(10, 8)
  checkOutLongitude Decimal?   @db.Decimal(11, 8)
  checkInMethod     String?
  checkOutMethod    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  attendance        Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, checkIn])
}

model AttendanceRegularization {
  id                String               @id @default(cuid())
  tenantId          String
  userId            String
  attendanceId      String?
  date              DateTime
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            RegularizationStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance        Attendance?          @relation(fields: [attendanceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reviewedBy        User?                @relation("ReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([userId])
  @@index([attendanceId, tenantId])
  @@index([reviewedByUserId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

model Holiday {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  date      DateTime
  type      HolidayType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, date])
}

model LeaveBalance {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  year          Int
  leaveType     LeaveType
  totalDays     Int
  usedDays      Int       @default(0)
  remainingDays Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, year, leaveType])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, year])
}

model Counter {
  id        String   @id @default(cuid())
  tenantId  String
  name      String // e.g., "employee", "department", etc.
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name], name: "uk_counter_tenant_name")
  @@index([tenantId])
}

model AttendancePolicy {
  id              String                   @id @default(cuid())
  tenantId        String
  policyType      AttendancePolicyType     @default(FLEXIBLE)
  ipRanges        Json?                    // Array of {start, end} - for multiple routers: [{start: "192.168.1.0", end: "192.168.1.255"}, {start: "192.168.2.0", end: "192.168.2.255"}]
  radiusMeters    Int                      @default(100) // Geolocation radius in meters
  wifiSsids       String[]                 // Array of office WiFi SSIDs: ["Office-Main", "Office-Guest", "Office-5G"]
  status          Status                   @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@index([tenantId])
}
