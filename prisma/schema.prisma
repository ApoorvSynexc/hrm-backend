// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  MISSING_CHECKIN
  MISSING_CHECKOUT
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Tenant {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  refreshTokens             RefreshToken[]
  roles                     Role[]
  permissions               Permission[]
  employees                 Employee[]
  departments               Department[]
  leaves                    Leave[]
  payrolls                  Payroll[]
  rolePermissions           RolePermission[]
  attendances               Attendance[]
  attendanceRegularizations AttendanceRegularization[]
}

model User {
  id                                String                     @id @default(cuid())
  tenantId                          String?
  email                             String
  passwordHash                      String
  firstName                         String?
  lastName                          String?
  isActive                          Boolean                    @default(true)
  roleId                            String?
  createdAt                         DateTime                   @default(now())
  updatedAt                         DateTime                   @updatedAt
  tenant                            Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                              Role?                      @relation(fields: [roleId], references: [id], onDelete: NoAction)
  refreshTokens                     RefreshToken[]
  employee                          Employee?
  reviewedAttendanceRegularizations AttendanceRegularization[]

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String?
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Permission {
  id              String           @id @default(cuid())
  tenantId        String?
  action          String
  subject         String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, action, subject])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id @default(cuid())
  tenantId     String?
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
}

model Employee {
  id                        String                     @id @default(cuid())
  tenantId                  String
  userId                    String?
  departmentId              String?
  employeeCode              String
  firstName                 String
  lastName                  String
  email                     String?
  phone                     String?
  designation               String?
  hireDate                  DateTime
  status                    EmploymentStatus           @default(ACTIVE)
  salary                    Decimal?                   @db.Decimal(12, 2)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                      User?                      @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: NoAction)
  department                Department?                @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: NoAction)
  leaves                    Leave[]
  payrolls                  Payroll[]
  attendances               Attendance[]
  attendanceRegularizations AttendanceRegularization[]

  @@unique([tenantId, employeeCode])
  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([departmentId, tenantId])
  @@index([userId, tenantId])
}

model Department {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Leave {
  id         String      @id @default(cuid())
  tenantId   String
  employeeId String
  type       LeaveType
  status     LeaveStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  reason     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, tenantId])
  @@index([tenantId, status])
}

model Payroll {
  id          String        @id @default(cuid())
  tenantId    String
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  basicSalary Decimal       @db.Decimal(12, 2)
  allowances  Decimal       @default(0) @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  netPay      Decimal       @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee      @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([employeeId, tenantId])
  @@index([tenantId, status])
}

model Attendance {
  id              String                     @id @default(cuid())
  tenantId        String
  employeeId      String
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  totalMinutes    Int?
  status          AttendanceStatus
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee                   @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  regularizations AttendanceRegularization[]

  @@unique([tenantId, employeeId, date])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([employeeId, tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

model AttendanceRegularization {
  id                String               @id @default(cuid())
  tenantId          String
  employeeId        String
  attendanceId      String?
  date              DateTime
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            RegularizationStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          Employee             @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  attendance        Attendance?          @relation(fields: [attendanceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reviewedBy        User?                @relation(fields: [reviewedByUserId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@index([tenantId])
  @@index([employeeId, tenantId])
  @@index([attendanceId, tenantId])
  @@index([reviewedByUserId, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}
